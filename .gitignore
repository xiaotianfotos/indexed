node_modules/
dist/
.DS_Store
*.log
.env
.env.*
!.env.example
coverage/
test-results/
playwright-report/
.data/

# Runtime configuration and credentials never belong in the repository.
config.local.json
secrets.json
.indexed-extension-key

# Internal documentation and benchmark reports stay local, including
# AGENTS and Markdown templates. Keep the public root README, legal notices and Skill entry
# point: those are required distribution metadata or functional interfaces.
/docs/
*.md
*.markdown
*.mdx
*.rst
*.adoc
!/README.md
!LICENSE*
!LICENCE*
!COPYING*
!NOTICE*
!THIRD_PARTY_NOTICES.md
!ACKNOWLEDGMENTS.md
!/skills/**/SKILL.md
/native/apple-embedding/results/

# Publish only the selected CI and gated HomeRail review workflows.
/.github/workflows/*
!/.github/workflows/ci.yml
!/.github/workflows/pr-review.yml
!/.github/workflows/release-extension.yml
/.github/dependabot.yml

# Historical Python, conversion and reference tools are kept locally only.
/native/apple-embedding/*.py
/native/apple-embedding/requirements*.txt
/native/apple-embedding/private_ane/
/native/apple-embedding/validation/
/native/apple-embedding/mixed-query-set/
/native/apple-embedding/benchmark_*.ts
/native/apple-embedding/electron-service-client.mjs
/native/apple-embedding/test_electron_client.mjs
/native/apple-embedding/inspect_coreml_compute_plan.swift
/native/apple-embedding/omlx-short-sequence.patch
/tests/native-reference-tools.test.ts
