{
  "manifest_version": 3,
  "name": "Indexed",
  "version": "0.14.1",
  "description": "把你主动选择的视频变成可由人类与 AI 查询的十秒画面和字幕向量记忆。",
  "key": "",
  "permissions": [
    "alarms",
    "scripting",
    "storage",
    "tabs",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://i.ytimg.com/*",
    "https://www.bilibili.com/*",
    "https://space.bilibili.com/*",
    "https://i0.hdslb.com/*",
    "https://i1.hdslb.com/*",
    "https://i2.hdslb.com/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/indexed-16.png",
    "32": "icons/indexed-32.png",
    "48": "icons/indexed-48.png",
    "128": "icons/indexed-128.png"
  },
  "action": {
    "default_title": "Indexed",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/indexed-16.png",
      "32": "icons/indexed-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/watch*",
        "https://www.bilibili.com/video/*"
      ],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ]
}
